<?xml version="1.0" encoding="utf-8"?>
<!--
  Hermetic package sources for building the bundled WorktreePredictor assembly.
  <clear/> drops any machine- or user-level sources so the build depends only on
  the public nuget.org feed and never contacts an authenticated private feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
