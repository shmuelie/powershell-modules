<?xml version="1.0" encoding="utf-8"?>
<Configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PowerShell/PowerShell/master/src/Schemas/Format.xsd">
  <ViewDefinitions>
    <View>
      <Name>AppInstallMonitor</Name>
      <ViewSelectedBy>
        <TypeName>Shmuelie.Windows.AppInstall.AppInstallMonitorResult</TypeName>
        <TypeName>Deserialized.Shmuelie.Windows.AppInstall.AppInstallMonitorResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><PropertyName>ContextId</PropertyName></ListItem>
          <ListItem><PropertyName>LocalItemId</PropertyName></ListItem>
          <ListItem><PropertyName>UserScope</PropertyName></ListItem>
          <ListItem><PropertyName>Outcome</PropertyName></ListItem>
          <ListItem><PropertyName>GroupOutcome</PropertyName></ListItem>
          <ListItem><Label>ObservationCount</Label><ScriptBlock>$_.Observations.Count</ScriptBlock></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>

    <!-- ServiceProcess: Get-ServiceProcess -->
    <View>
      <Name>ServiceProcess</Name>
      <ViewSelectedBy>
        <TypeName>ServiceProcess</TypeName>
        <TypeName>Shmuelie.Windows.Cmdlets.ServiceProcessInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>ProcessId</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>ProcessName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>
                $color = switch ([string]$_.Status) {
                    'Running' { $PSStyle.Foreground.Green }
                    'Stopped' { $PSStyle.Foreground.Red }
                    default   { $PSStyle.Foreground.BrightBlack }
                }
                "$color$($_.Status)$($PSStyle.Reset)"
              </ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.ProcessId -gt 0) { $_.ProcessId } else { '' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ProcessName</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- SubstDrive: Get-SubstDrive -->
    <View>
      <Name>SubstDrive</Name>
      <ViewSelectedBy>
        <TypeName>SubstDrive</TypeName>
        <TypeName>Shmuelie.Windows.Cmdlets.SubstDrive</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>DriveLetter</Label><Width>11</Width></TableColumnHeader>
          <TableColumnHeader><Label>TargetPath</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>DriveLetter</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>TargetPath</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <!-- AppInstall request: omit caller-native correlation and diagnostic payloads by default. -->
    <View>
      <Name>AppInstallRequest</Name>
      <ViewSelectedBy>
        <TypeName>Shmuelie.Windows.AppInstall.AppInstallRequestSnapshot</TypeName>
        <TypeName>Deserialized.Shmuelie.Windows.AppInstall.AppInstallRequestSnapshot</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>RequestId</PropertyName></ListItem>
              <ListItem><PropertyName>ContextId</PropertyName></ListItem>
              <ListItem><PropertyName>SourceOperation</PropertyName></ListItem>
              <ListItem><PropertyName>UserScope</PropertyName></ListItem>
              <ListItem><PropertyName>Acceptance</PropertyName></ListItem>
              <ListItem><PropertyName>OperationState</PropertyName></ListItem>
              <ListItem><PropertyName>WaitState</PropertyName></ListItem>
              <ListItem><PropertyName>ItemsAvailability</PropertyName></ListItem>
              <ListItem><Label>ItemCount</Label><ScriptBlock>$_.Items.Count</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>

  </ViewDefinitions>
</Configuration>
