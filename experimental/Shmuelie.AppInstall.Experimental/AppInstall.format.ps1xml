<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>AppInstallMonitor</Name>
      <ViewSelectedBy>
        <TypeName>Shmuelie.Windows.AppInstall.AppInstallMonitorResult</TypeName>
        <TypeName>Deserialized.Shmuelie.Windows.AppInstall.AppInstallMonitorResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries><ListEntry><ListItems>
          <ListItem><PropertyName>ContextId</PropertyName></ListItem>
          <ListItem><PropertyName>LocalItemId</PropertyName></ListItem>
          <ListItem><PropertyName>UserScope</PropertyName></ListItem>
          <ListItem><PropertyName>Outcome</PropertyName></ListItem>
          <ListItem><PropertyName>GroupOutcome</PropertyName></ListItem>
          <ListItem><Label>ObservationCount</Label><ScriptBlock>$_.Observations.Count</ScriptBlock></ListItem>
        </ListItems></ListEntry></ListEntries>
      </ListControl>
    </View>

    <View>
      <Name>AppInstallRequest</Name>
      <ViewSelectedBy>
        <TypeName>Shmuelie.Windows.AppInstall.AppInstallRequestSnapshot</TypeName>
        <TypeName>Deserialized.Shmuelie.Windows.AppInstall.AppInstallRequestSnapshot</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>RequestId</PropertyName></ListItem>
              <ListItem><PropertyName>ContextId</PropertyName></ListItem>
              <ListItem><PropertyName>SourceOperation</PropertyName></ListItem>
              <ListItem><PropertyName>UserScope</PropertyName></ListItem>
              <ListItem><PropertyName>Acceptance</PropertyName></ListItem>
              <ListItem><PropertyName>OperationState</PropertyName></ListItem>
              <ListItem><PropertyName>WaitState</PropertyName></ListItem>
              <ListItem><PropertyName>ItemsAvailability</PropertyName></ListItem>
              <ListItem><Label>ItemCount</Label><ScriptBlock>$_.Items.Count</ScriptBlock></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
